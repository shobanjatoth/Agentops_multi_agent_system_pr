# LLM (free tier — get a key at https://console.groq.com/keys)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=openai/gpt-oss-120b

# MCP-style tool credentials (optional — tools fall back to mock mode without them)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxx
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/xxx/xxx

# Concurrency — max tasks the /tasks/batch endpoint runs through the graph at once
MAX_CONCURRENT_TASKS=3
MAX_BATCH_SIZE=20

# Observability
AGENTOPS_DB_PATH=./data/agentops.db

# Redis (optional — falls back to an in-memory store automatically if unset
# or unreachable). Without it, pending human-approvals are lost on restart
# and invisible across multiple worker processes; with it, they persist and
# are shared. Local dev: `docker run -p 6379:6379 redis` or `redis-server`.
REDIS_URL=redis://localhost:6379/0
APPROVAL_TTL_SECONDS=86400

# LangSmith tracing (optional — free tier at smith.langchain.com).
# When set, every LangGraph node run, LLM call, and tool call is automatically
# traced with full input/output + latency waterfall — separate from (and
# complementary to) the custom EvalTracker/SQLite layer, which tracks the
# business-specific metrics LangSmith doesn't know about (risk score, cost
# per task, approval outcomes). Leave unset to run with zero tracing overhead.
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls__xxxxxxxxxxxxxxxxxxxxx
LANGCHAIN_PROJECT=agentops

# LLM response caching (Redis or in-memory fallback)
# Identical (system, prompt) pairs within this window skip the Groq API call.
LLM_CACHE_TTL_SECONDS=300

# Guardrails
AUTO_APPROVE_RISK_THRESHOLD=0.3
